    "BMI",
    "Waist_Circumference_cm",
    "Blood_Glucose",
    "HbA1c",
    "Fasting_Blood_Sugar",
    "Insulin_Level",
    "Blood_Pressure_Systolic",
    "Blood_Pressure_Diastolic",
    "Total_Cholesterol",
    "HDL",
    "Family_History_Diabetes",
    "Hypertension",
    "Heart_Disease",
    "Diet_Quality",
    "Physical_Activity_Level",
    "Pulse_Pressure",
    "Chol_HDL_Ratio"
  ],
  "engineered_features": [
    "Pulse_Pressure",
    "Chol_HDL_Ratio"
  ],
  "feature_selection_percentile": 70,
  "random_seed": 42
}