UNWIND [
{id: "p07", source: "a1c", about: ["a1c"], focus: ["a1c"], title: "What does HbA1c measure?", text: "HbA1c reflects average blood glucose over roughly three months. Some conditions affecting red blood cells or hemoglobin can alter its reliability.", title_vi: "HbA1c ph\u1ea3n \u00e1nh \u0111i\u1ec1u g\u00ec?", text_vi: "HbA1c ph\u1ea3n \u00e1nh m\u1ee9c glucose m\u00e1u trung b\u00ecnh trong kho\u1ea3ng ba th\u00e1ng. M\u1ed9t s\u1ed1 t\u00ecnh tr\u1ea1ng li\u00ean quan \u0111\u1ebfn h\u1ed3ng c\u1ea7u ho\u1eb7c hemoglobin c\u00f3 th\u1ec3 \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn \u0111\u1ed9 tin c\u1eady c\u1ee7a k\u1ebft qu\u1ea3."},
{id: "p26", claims: ["a1c.standard_test.fasting_required=no"], source: "a1c", about: ["a1c", "fasting"], focus: ["fasting"], title: "HbA1c usually requires no fasting", text: "A standard HbA1c test normally does not require fasting. A separate fasting glucose test measures blood glucose at one point and has different preparation.", title_vi: "HbA1c th\u01b0\u1eddng kh\u00f4ng c\u1ea7n nh\u1ecbn \u0103n", text_vi: "X\u00e9t nghi\u1ec7m HbA1c th\u00f4ng th\u01b0\u1eddng kh\u00f4ng c\u1ea7n nh\u1ecbn \u0103n. X\u00e9t nghi\u1ec7m glucose huy\u1ebft t\u01b0\u01a1ng l\u00fac \u0111\u00f3i \u0111o t\u1ea1i m\u1ed9t th\u1eddi \u0111i\u1ec3m v\u00e0 c\u00f3 y\u00eau c\u1ea7u chu\u1ea9n b\u1ecb kh\u00e1c."},
{id: "p22", source: "cdcdka", about: ["dka", "type1", "type2"], focus: ["dka"], title: "Diabetic ketoacidosis can be an emergency", text: "Diabetic ketoacidosis is a serious complication linked to insufficient insulin. Persistent vomiting or trouble breathing in a suspected episode warrants emergency care.", title_vi: "Nhi\u1ec5m toan ceton c\u00f3 th\u1ec3 l\u00e0 c\u1ea5p c\u1ee9u", text_vi: "Nhi\u1ec5m toan ceton l\u00e0 bi\u1ebfn ch\u1ee9ng nghi\u00eam tr\u1ecdng li\u00ean quan \u0111\u1ebfn thi\u1ebfu insulin. Khi nghi ng\u1edd c\u00f3 bi\u1ebfn ch\u1ee9ng n\u00e0y v\u00e0 \u0111ang n\u00f4n li\u00ean t\u1ee5c ho\u1eb7c kh\u00f3 th\u1edf, c\u1ea7n \u0111\u01b0\u1ee3c \u0111\u00e1nh gi\u00e1 c\u1ea5p c\u1ee9u."},
{id: "p21", source: "cdclow", about: ["hypoglycemia", "symptom"], focus: ["hypoglycemia"], title: "Recognizing low blood sugar", text: "Low blood sugar may cause shaking, sweating, hunger, or dizziness. Severe episodes may involve confusion, seizures, or loss of consciousness and need immediate help.", title_vi: "D\u1ea5u hi\u1ec7u h\u1ea1 \u0111\u01b0\u1eddng huy\u1ebft", text_vi: "H\u1ea1 \u0111\u01b0\u1eddng huy\u1ebft c\u00f3 th\u1ec3 g\u00e2y run tay, v\u00e3 m\u1ed3 h\u00f4i, \u0111\u00f3i ho\u1eb7c ch\u00f3ng m\u1eb7t. Tr\u01b0\u1eddng h\u1ee3p n\u1eb7ng c\u00f3 th\u1ec3 g\u00e2y l\u00fa l\u1eabn, co gi\u1eadt ho\u1eb7c m\u1ea5t \u00fd th\u1ee9c v\u00e0 c\u1ea7n \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 kh\u1ea9n c\u1ea5p."},
{id: "p12", source: "codebook", about: ["survey"], focus: ["survey"], title: "Original BRFSS survey question", text: "DIABETE3 records whether respondents report having ever been told they had diabetes. The CDC codebook describes the original survey coding.", title_vi: "C\u00e2u h\u1ecfi g\u1ed1c c\u1ee7a kh\u1ea3o s\u00e1t BRFSS", text_vi: "M\u00e3 DIABETE3 m\u00f4 t\u1ea3 c\u00e2u h\u1ecfi ph\u1ecfng v\u1ea5n v\u1ec1 vi\u1ec7c ng\u01b0\u1eddi tham gia t\u1eebng \u0111\u01b0\u1ee3c th\u00f4ng b\u00e1o c\u00f3 \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng hay ch\u01b0a. Codebook CDC m\u00f4 t\u1ea3 quy \u01b0\u1edbc c\u1ee7a kh\u1ea3o s\u00e1t g\u1ed1c."},
{id: "p13", source: "curated", about: ["survey", "prediabetes"], focus: ["survey"], title: "Meaning of Diabetes_012", text: "In the processed dataset, 0, 1, and 2 represent no reported diabetes, reported prediabetes, and reported diabetes. Code 2 does not specify diabetes type.", title_vi: "\u00dd ngh\u0129a nh\u00e3n Diabetes_012", text_vi: "Trong b\u1ea3n d\u1eef li\u1ec7u \u0111\u00e3 x\u1eed l\u00fd, nh\u00e3n 0, 1 v\u00e0 2 l\u1ea7n l\u01b0\u1ee3t ch\u1ec9 kh\u00f4ng b\u00e1o c\u00e1o \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng, b\u00e1o c\u00e1o ti\u1ec1n \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng v\u00e0 b\u00e1o c\u00e1o \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng. Gi\u00e1 tr\u1ecb 2 c\u1ee7a nh\u00e3n kh\u00f4ng c\u00f3 ngh\u0129a l\u00e0 \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng t\u00edp 2."},
{id: "p23", source: "footguide", about: ["foot", "diabetes", "complication"], focus: ["foot"], title: "Diabetes and foot care", text: "Nerve damage may make foot injuries harder to notice. Regular inspection is useful. A new sore or a wound that is not healing should be assessed by a health professional.", title_vi: "B\u00e0n ch\u00e2n v\u00e0 b\u1ec7nh ti\u1ec3u \u0111\u01b0\u1eddng", text_vi: "T\u1ed5n th\u01b0\u01a1ng th\u1ea7n kinh c\u00f3 th\u1ec3 khi\u1ebfn v\u1ebft th\u01b0\u01a1ng b\u00e0n ch\u00e2n kh\u00f3 \u0111\u01b0\u1ee3c nh\u1eadn ra. Ki\u1ec3m tra b\u00e0n ch\u00e2n \u0111\u1ec1u \u0111\u1eb7n gi\u00fap ph\u00e1t hi\u1ec7n s\u1edbm. N\u00ean trao \u0111\u1ed5i v\u1edbi nh\u00e2n vi\u00ean y t\u1ebf v\u1ec1 v\u1ebft lo\u00e9t m\u1edbi ho\u1eb7c v\u1ebft th\u01b0\u01a1ng l\u00e2u l\u00e0nh."},
{id: "p27", source: "gestoverview", about: ["gestational"], focus: ["gestational"], title: "What is gestational diabetes?", text: "Gestational diabetes is a form of diabetes that develops during pregnancy. It can affect the health of both the pregnant person and baby. Prenatal screening can identify it even when symptoms are absent.", title_vi: "\u0110\u00e1i th\u00e1o \u0111\u01b0\u1eddng thai k\u1ef3 l\u00e0 g\u00ec?", text_vi: "\u0110\u00e1i th\u00e1o \u0111\u01b0\u1eddng thai k\u1ef3 l\u00e0 m\u1ed9t d\u1ea1ng \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng xu\u1ea5t hi\u1ec7n trong thai k\u1ef3. T\u00ecnh tr\u1ea1ng n\u00e0y c\u00f3 th\u1ec3 \u1ea3nh h\u01b0\u1edfng \u0111\u1ebfn s\u1ee9c kh\u1ecfe c\u1ee7a m\u1eb9 v\u00e0 b\u00e9. S\u00e0ng l\u1ecdc tr\u01b0\u1edbc sinh gi\u00fap ph\u00e1t hi\u1ec7n b\u1ec7nh ngay c\u1ea3 khi kh\u00f4ng c\u00f3 tri\u1ec7u ch\u1ee9ng."},
{id: "p18", source: "gesttests", about: ["gestational", "glucose"], focus: ["gestational"], title: "Testing during pregnancy", text: "NIDDK describes routine gestational diabetes testing around weeks 24\u201328. Testing may occur earlier in selected patients. The test method and interpretation are determined by the prenatal care team.", title_vi: "X\u00e9t nghi\u1ec7m ti\u1ec3u \u0111\u01b0\u1eddng thai k\u1ef3 khi n\u00e0o?", text_vi: "NIDDK m\u00f4 t\u1ea3 vi\u1ec7c s\u00e0ng l\u1ecdc ti\u1ec3u \u0111\u01b0\u1eddng thai k\u1ef3 th\u01b0\u1eddng di\u1ec5n ra \u1edf tu\u1ea7n 24\u201328. M\u1ed9t s\u1ed1 tr\u01b0\u1eddng h\u1ee3p \u0111\u01b0\u1ee3c \u0111\u00e1nh gi\u00e1 s\u1edbm h\u01a1n. Nh\u00f3m ch\u0103m s\u00f3c thai k\u1ef3 quy\u1ebft \u0111\u1ecbnh lo\u1ea1i x\u00e9t nghi\u1ec7m v\u00e0 di\u1ec5n gi\u1ea3i k\u1ebft qu\u1ea3."},
{id: "p20", claims: ["a1c.standard_test.fasting_required=no", "fpg.standard_test.fasting_required=yes"], source: "longfast", about: ["fasting", "a1c", "glucose"], focus: ["fasting"], title: "Whether fasting is required depends on the test", text: "HbA1c normally requires no fasting. Fasting plasma glucose does require fasting. Confirm the exact test and preparation with the testing site.", title_vi: "Nh\u1ecbn \u0103n t\u00f9y theo lo\u1ea1i x\u00e9t nghi\u1ec7m", text_vi: "X\u00e9t nghi\u1ec7m HbA1c th\u01b0\u1eddng kh\u00f4ng c\u1ea7n nh\u1ecbn \u0103n. X\u00e9t nghi\u1ec7m glucose huy\u1ebft t\u01b0\u01a1ng l\u00fac \u0111\u00f3i c\u1ea7n nh\u1ecbn \u0103n. H\u00e3y x\u00e1c nh\u1eadn t\u00ean x\u00e9t nghi\u1ec7m v\u00e0 c\u00e1ch chu\u1ea9n b\u1ecb v\u1edbi c\u01a1 s\u1edf th\u1ef1c hi\u1ec7n."},
{id: "p25", source: "longfollow", about: ["followup", "foot", "complication"], focus: ["followup"], title: "Monitoring beyond glucose", text: "Long Chau discusses monitoring blood pressure, kidney and eye health, and the feet. The schedule and targets depend on the individual's care plan.", title_vi: "Theo d\u00f5i g\u00ec ngo\u00e0i \u0111\u01b0\u1eddng huy\u1ebft?", text_vi: "Long Ch\u00e2u \u0111\u1ec1 c\u1eadp vi\u1ec7c theo d\u00f5i huy\u1ebft \u00e1p, ch\u1ee9c n\u0103ng th\u1eadn, m\u1eaft v\u00e0 b\u00e0n ch\u00e2n. L\u1ecbch theo d\u00f5i v\u00e0 m\u1ee5c ti\u00eau c\u1ee5 th\u1ec3 c\u1ea7n \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh c\u00f9ng nh\u00f3m \u0111i\u1ec1u tr\u1ecb."},
{id: "p19", source: "longgest", about: ["gestational", "glucose", "symptom"], focus: ["gestational", "symptom"], title: "Vietnamese overview of gestational screening", text: "Long Chau describes prenatal glucose screening and notes that gestational diabetes may not have clear symptoms. The prenatal care team should provide instructions for preparation.", title_vi: "T\u1ea7m so\u00e1t thai k\u1ef3 trong ch\u0103m s\u00f3c tr\u01b0\u1edbc sinh", text_vi: "Long Ch\u00e2u gi\u1ea3i th\u00edch vai tr\u00f2 c\u1ee7a t\u1ea7m so\u00e1t \u0111\u01b0\u1eddng huy\u1ebft trong thai k\u1ef3. Tri\u1ec7u ch\u1ee9ng c\u00f3 th\u1ec3 kh\u00f4ng r\u00f5. H\u00e3y nh\u1eadn h\u01b0\u1edbng d\u1eabn chu\u1ea9n b\u1ecb x\u00e9t nghi\u1ec7m t\u1eeb c\u01a1 s\u1edf theo d\u00f5i thai."},
{id: "p14", source: "overview", about: ["diabetes", "type1", "type2"], focus: ["diabetes"], title: "What is diabetes?", text: "Diabetes refers to conditions involving elevated blood glucose. Insulin helps glucose enter cells. Glucose can rise when insulin is insufficient or less effective.", title_vi: "\u0110\u00e1i th\u00e1o \u0111\u01b0\u1eddng l\u00e0 g\u00ec?", text_vi: "\u0110\u00e1i th\u00e1o \u0111\u01b0\u1eddng l\u00e0 m\u1ed9t nh\u00f3m t\u00ecnh tr\u1ea1ng c\u00f3 m\u1ee9c glucose trong m\u00e1u cao. Insulin gi\u00fap glucose t\u1eeb m\u00e1u \u0111i v\u00e0o t\u1ebf b\u00e0o. M\u1ee9c glucose c\u00f3 th\u1ec3 t\u0103ng khi c\u01a1 th\u1ec3 kh\u00f4ng t\u1ea1o \u0111\u1ee7 insulin ho\u1eb7c kh\u00f4ng s\u1eed d\u1ee5ng insulin hi\u1ec7u qu\u1ea3."},
{id: "p11", source: "prediabetes", about: ["prediabetes", "type2"], focus: ["prediabetes"], title: "What is prediabetes?", text: "Prediabetes means blood glucose is higher than usual but below the diabetes range. It is associated with a higher chance of developing type 2 diabetes.", title_vi: "Ti\u1ec1n \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng", text_vi: "Ti\u1ec1n \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng l\u00e0 t\u00ecnh tr\u1ea1ng glucose m\u00e1u cao h\u01a1n m\u1ee9c b\u00ecnh th\u01b0\u1eddng nh\u01b0ng ch\u01b0a \u0111\u1ea1t m\u1ee9c d\u00f9ng \u0111\u1ec3 ch\u1ea9n \u0111o\u00e1n \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng. T\u00ecnh tr\u1ea1ng n\u00e0y li\u00ean quan \u0111\u1ebfn nguy c\u01a1 ti\u1ebfn tri\u1ec3n th\u00e0nh t\u00edp 2."},
{id: "p06", source: "prevention", about: ["type2", "prevention", "activity"], focus: ["prevention", "activity"], title: "Preventing or delaying type 2 diabetes", text: "Lifestyle changes, including greater physical activity and changes in eating habits, can lower the chance of developing type 2 diabetes in some people at risk.", title_vi: "Ph\u00f2ng ng\u1eeba ho\u1eb7c tr\u00ec ho\u00e3n t\u00edp 2", text_vi: "Thay \u0111\u1ed5i l\u1ed1i s\u1ed1ng, bao g\u1ed3m t\u0103ng ho\u1ea1t \u0111\u1ed9ng th\u1ec3 ch\u1ea5t v\u00e0 \u0111i\u1ec1u ch\u1ec9nh ch\u1ebf \u0111\u1ed9 \u0103n, c\u00f3 th\u1ec3 gi\u00fap m\u1ed9t s\u1ed1 ng\u01b0\u1eddi c\u00f3 nguy c\u01a1 gi\u1ea3m kh\u1ea3 n\u0103ng ti\u1ebfn tri\u1ec3n th\u00e0nh \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng t\u00edp 2."},
{id: "p10", source: "problems", about: ["diabetes", "complication"], focus: ["complication"], title: "Related complications", text: "Diabetes is associated with cardiovascular, kidney, eye, and nerve problems. Regular follow-up can help detect and manage these complications.", title_vi: "Bi\u1ebfn ch\u1ee9ng li\u00ean quan", text_vi: "\u0110\u00e1i th\u00e1o \u0111\u01b0\u1eddng c\u00f3 th\u1ec3 li\u00ean quan \u0111\u1ebfn v\u1ea5n \u0111\u1ec1 \u1edf tim m\u1ea1ch, th\u1eadn, m\u1eaft ho\u1eb7c th\u1ea7n kinh. Theo d\u00f5i v\u00e0 ch\u0103m s\u00f3c \u0111\u1ecbnh k\u1ef3 gi\u00fap ph\u00e1t hi\u1ec7n v\u00e0 qu\u1ea3n l\u00fd c\u00e1c v\u1ea5n \u0111\u1ec1 n\u00e0y."},
{id: "p05", source: "risk", about: ["type2", "risk", "activity", "family"], focus: ["risk", "activity", "family"], title: "Type 2 diabetes risk factors", text: "Family history, overweight or obesity, and low physical activity are associated with type 2 diabetes. A risk factor alone cannot determine whether someone has diabetes.", title_vi: "Y\u1ebfu t\u1ed1 nguy c\u01a1 t\u00edp 2", text_vi: "C\u00e1c y\u1ebfu t\u1ed1 li\u00ean quan t\u1edbi nguy c\u01a1 t\u00edp 2 g\u1ed3m ti\u1ec1n s\u1eed gia \u0111\u00ecnh, th\u1eeba c\u00e2n ho\u1eb7c b\u00e9o ph\u00ec v\u00e0 \u00edt ho\u1ea1t \u0111\u1ed9ng th\u1ec3 ch\u1ea5t. M\u1ed9t y\u1ebfu t\u1ed1 nguy c\u01a1 ri\u00eang l\u1ebb kh\u00f4ng x\u00e1c \u0111\u1ecbnh m\u1ed9t ng\u01b0\u1eddi c\u00f3 m\u1eafc b\u1ec7nh hay kh\u00f4ng."},
{id: "p09", source: "symptoms", about: ["type1", "type2", "symptom"], focus: ["symptom"], title: "Symptoms that may occur", text: "Possible symptoms include increased thirst, frequent urination, tiredness, and unintentional weight loss. Type 2 diabetes can develop gradually with few noticeable signs.", title_vi: "Bi\u1ec3u hi\u1ec7n c\u00f3 th\u1ec3 g\u1eb7p", text_vi: "C\u00e1c bi\u1ec3u hi\u1ec7n c\u00f3 th\u1ec3 g\u1ed3m kh\u00e1t nhi\u1ec1u, \u0111i ti\u1ec3u nhi\u1ec1u, m\u1ec7t m\u1ecfi ho\u1eb7c s\u1ee5t c\u00e2n kh\u00f4ng ch\u1ee7 \u00fd. \u0110\u00e1i th\u00e1o \u0111\u01b0\u1eddng t\u00edp 2 c\u00f3 th\u1ec3 ti\u1ebfn tri\u1ec3n ch\u1eadm v\u00e0 \u00edt bi\u1ec3u hi\u1ec7n r\u00f5 r\u00e0ng."},
{id: "p08", source: "tests", about: ["glucose", "a1c", "diabetes"], focus: ["glucose"], title: "Common blood tests", text: "Tests used to assess blood glucose include HbA1c, fasting plasma glucose, and the oral glucose tolerance test. Health professionals select and interpret tests in context.", title_vi: "C\u00e1c x\u00e9t nghi\u1ec7m th\u01b0\u1eddng d\u00f9ng", text_vi: "C\u00e1c x\u00e9t nghi\u1ec7m \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng \u0111\u1ec3 \u0111\u00e1nh gi\u00e1 \u0111\u01b0\u1eddng huy\u1ebft g\u1ed3m HbA1c, glucose huy\u1ebft t\u01b0\u01a1ng l\u00fac \u0111\u00f3i v\u00e0 nghi\u1ec7m ph\u00e1p dung n\u1ea1p glucose. Nh\u00e2n vi\u00ean y t\u1ebf l\u1ef1a ch\u1ecdn v\u00e0 di\u1ec5n gi\u1ea3i x\u00e9t nghi\u1ec7m theo ho\u00e0n c\u1ea3nh."},
{id: "p24", source: "tests", about: ["threshold", "a1c", "glucose", "type2"], focus: ["threshold"], title: "What do diagnostic thresholds mean?", text: "NIDDK lists HbA1c of 5.7\u20136.4% as the prediabetes range and 6.5% or higher as the diabetes range for relevant nonpregnant populations. A clinician may repeat testing to confirm. These categories cannot classify diabetes type or replace clinical interpretation.", title_vi: "Ng\u01b0\u1ee1ng HbA1c trong x\u00e9t nghi\u1ec7m ch\u1ea9n \u0111o\u00e1n", text_vi: "Trong b\u1ed1i c\u1ea3nh \u00e1p d\u1ee5ng cho ng\u01b0\u1eddi kh\u00f4ng mang thai, NIDDK n\u00eau HbA1c t\u1eeb 5,7\u20136,4% thu\u1ed9c kho\u1ea3ng ti\u1ec1n \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng v\u00e0 t\u1eeb 6,5% tr\u1edf l\u00ean thu\u1ed9c kho\u1ea3ng \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng. B\u00e1c s\u0129 c\u00f3 th\u1ec3 c\u1ea7n x\u00e9t nghi\u1ec7m x\u00e1c nh\u1eadn. C\u00e1c ng\u01b0\u1ee1ng n\u00e0y kh\u00f4ng x\u00e1c \u0111\u1ecbnh t\u00edp b\u1ec7nh v\u00e0 c\u1ea7n \u0111\u01b0\u1ee3c di\u1ec5n gi\u1ea3i trong b\u1ed1i c\u1ea3nh l\u00e2m s\u00e0ng."},
{id: "p01", source: "type1", about: ["type1"], focus: ["type1"], title: "Type 1 and autoimmunity", text: "In type 1 diabetes, the immune system destroys insulin-producing beta cells in the pancreas. Type 1 can develop in children or adults.", title_vi: "T\u00edp 1 v\u00e0 c\u01a1 ch\u1ebf t\u1ef1 mi\u1ec5n", text_vi: "Trong \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng t\u00edp 1, h\u1ec7 mi\u1ec5n d\u1ecbch ph\u00e1 h\u1ee7y c\u00e1c t\u1ebf b\u00e0o beta c\u1ee7a tuy\u1ebfn t\u1ee5y s\u1ea3n xu\u1ea5t insulin. T\u00edp 1 c\u00f3 th\u1ec3 xu\u1ea5t hi\u1ec7n \u1edf tr\u1ebb em v\u00e0 ng\u01b0\u1eddi tr\u01b0\u1edfng th\u00e0nh."},
{id: "p03", source: "type1", about: ["type1", "antibody", "glucose"], focus: ["type1", "antibody", "glucose"], title: "Blood tests and diabetes classification", text: "Blood tests can establish diabetes. When type 1 is suspected, health professionals may use autoantibody tests to help classify it.", title_vi: "X\u00e1c \u0111\u1ecbnh t\u00edp b\u1eb1ng x\u00e9t nghi\u1ec7m", text_vi: "X\u00e9t nghi\u1ec7m m\u00e1u c\u00f3 th\u1ec3 x\u00e1c \u0111\u1ecbnh t\u00ecnh tr\u1ea1ng \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng. Khi nghi ng\u1edd t\u00edp 1, nh\u00e2n vi\u00ean y t\u1ebf c\u00f3 th\u1ec3 d\u00f9ng x\u00e9t nghi\u1ec7m t\u1ef1 kh\u00e1ng th\u1ec3 \u0111\u1ec3 h\u1ed7 tr\u1ee3 x\u00e1c \u0111\u1ecbnh t\u00edp."},
{id: "p04", source: "type2", about: ["type2"], focus: ["type2"], title: "How type 2 diabetes develops", text: "In type 2 diabetes, insulin is used less effectively or the pancreas cannot make enough to keep blood glucose in the appropriate range.", title_vi: "C\u01a1 ch\u1ebf c\u1ee7a \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng t\u00edp 2", text_vi: "\u1ede t\u00edp 2, c\u01a1 th\u1ec3 s\u1eed d\u1ee5ng insulin k\u00e9m hi\u1ec7u qu\u1ea3 ho\u1eb7c tuy\u1ebfn t\u1ee5y kh\u00f4ng t\u1ea1o \u0111\u1ee7 insulin \u0111\u1ec3 duy tr\u00ec \u0111\u01b0\u1eddng huy\u1ebft trong ph\u1ea1m vi ph\u00f9 h\u1ee3p."},
{id: "p02", source: "vinmec", about: ["type1", "glucose"], focus: ["type1"], title: "Assessment of type 1 diabetes", text: "Vinmec describes blood glucose tests used to assess diabetes and symptoms that may occur in type 1. Classification requires the clinical context.", title_vi: "\u0110\u00e1nh gi\u00e1 \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng t\u00edp 1", text_vi: "B\u00e0i vi\u1ebft Vinmec m\u00f4 t\u1ea3 c\u00e1c x\u00e9t nghi\u1ec7m \u0111\u01b0\u1eddng huy\u1ebft \u0111\u01b0\u1ee3c d\u00f9ng khi \u0111\u00e1nh gi\u00e1 \u0111\u00e1i th\u00e1o \u0111\u01b0\u1eddng v\u00e0 \u0111\u1ec1 c\u1eadp nh\u1eefng bi\u1ec3u hi\u1ec7n th\u01b0\u1eddng g\u1eb7p \u1edf t\u00edp 1. Vi\u1ec7c x\u00e1c \u0111\u1ecbnh t\u00edp c\u1ea7n \u0111\u01b0\u1ee3c xem x\u00e9t trong b\u1ed1i c\u1ea3nh l\u00e2m s\u00e0ng."},
{id: "p15", source: "who", about: ["diabetes", "symptom", "type2"], focus: ["symptom"], title: "Why symptoms may go unnoticed", text: "WHO notes that type 2 symptoms may be mild. Thirst, frequent urination, blurred vision, or unplanned weight loss can occur. Clinical testing is needed to distinguish diabetes from other causes.", title_vi: "V\u00ec sao tri\u1ec7u ch\u1ee9ng c\u00f3 th\u1ec3 kh\u00f3 nh\u1eadn bi\u1ebft?", text_vi: "Theo WHO, tri\u1ec7u ch\u1ee9ng t\u00edp 2 c\u00f3 th\u1ec3 nh\u1eb9. Ng\u01b0\u1eddi b\u1ec7nh c\u00f3 th\u1ec3 kh\u00e1t nhi\u1ec1u, ti\u1ec3u nhi\u1ec1u, nh\u00ecn m\u1edd ho\u1eb7c s\u1ee5t c\u00e2n ngo\u00e0i \u00fd mu\u1ed1n. C\u1ea7n \u0111\u00e1nh gi\u00e1 y t\u1ebf \u0111\u1ec3 ph\u00e2n bi\u1ec7t v\u1edbi c\u00e1c nguy\u00ean nh\u00e2n kh\u00e1c."},
{id: "p16", source: "who", about: ["type2", "prevention", "activity"], focus: ["prevention"], title: "Preventing or delaying type 2", text: "WHO describes physical activity, a healthy diet, maintaining a healthy weight, and avoiding tobacco as ways to help prevent or delay type 2 diabetes.", title_vi: "Ph\u00f2ng ng\u1eeba ho\u1eb7c tr\u00ec ho\u00e3n t\u00edp 2", text_vi: "WHO n\u00eau v\u1eadn \u0111\u1ed9ng th\u01b0\u1eddng xuy\u00ean, \u0103n u\u1ed1ng l\u00e0nh m\u1ea1nh, duy tr\u00ec c\u00e2n n\u1eb7ng ph\u00f9 h\u1ee3p v\u00e0 tr\u00e1nh thu\u1ed1c l\u00e1 l\u00e0 c\u00e1c c\u00e1ch gi\u00fap ph\u00f2ng ng\u1eeba ho\u1eb7c tr\u00ec ho\u00e3n t\u00edp 2."},
{id: "p17", source: "who", about: ["diabetes", "complication", "followup"], focus: ["complication", "followup"], title: "Why regular checks matter", text: "Persistent high blood glucose can harm blood vessels and nerves. Regular screening and management can help detect or delay complications affecting the heart, eyes, kidneys, or feet.", title_vi: "V\u00ec sao c\u1ea7n theo d\u00f5i \u0111\u1ecbnh k\u1ef3?", text_vi: "\u0110\u01b0\u1eddng huy\u1ebft cao k\u00e9o d\u00e0i c\u00f3 th\u1ec3 g\u00e2y t\u1ed5n th\u01b0\u01a1ng m\u1ea1ch m\u00e1u v\u00e0 th\u1ea7n kinh. Theo d\u00f5i v\u00e0 ch\u0103m s\u00f3c \u0111\u1ecbnh k\u1ef3 gi\u00fap ph\u00e1t hi\u1ec7n ho\u1eb7c l\u00e0m ch\u1eadm bi\u1ebfn ch\u1ee9ng \u1edf tim, m\u1eaft, th\u1eadn ho\u1eb7c b\u00e0n ch\u00e2n."}
] AS row
MERGE (n:Passage {id: row.id}) SET n = row;

MATCH (p:Passage), (s:Source {id: p.source}) MERGE (p)-[:FROM_SOURCE]->(s);

MATCH (p:Passage) UNWIND p.about AS concept_id MATCH (c:Concept {id: concept_id}) MERGE (p)-[:ABOUT]->(c);

MATCH (a:Concept {id: "a1c"}), (b:Concept {id: "fasting"}) MERGE (a)-[r:HAS_PREPARATION_TOPIC]->(b) SET r.passage_id = "p26";

MATCH (a:Concept {id: "type1"}), (b:Concept {id: "dka"}) MERGE (a)-[r:HAS_ACUTE_COMPLICATION]->(b) SET r.passage_id = "p22";

MATCH (a:Concept {id: "type2"}), (b:Concept {id: "dka"}) MERGE (a)-[r:HAS_ACUTE_COMPLICATION]->(b) SET r.passage_id = "p22";

MATCH (a:Concept {id: "hypoglycemia"}), (b:Concept {id: "symptom"}) MERGE (a)-[r:HAS_SYMPTOM_TOPIC]->(b) SET r.passage_id = "p21";

MATCH (a:Concept {id: "diabetes"}), (b:Concept {id: "foot"}) MERGE (a)-[r:HAS_COMPLICATION_TOPIC]->(b) SET r.passage_id = "p23";

MATCH (a:Concept {id: "gestational"}), (b:Concept {id: "glucose"}) MERGE (a)-[r:ASSESSED_BY]->(b) SET r.passage_id = "p18";

MATCH (a:Concept {id: "prediabetes"}), (b:Concept {id: "type2"}) MERGE (a)-[r:ASSOCIATED_WITH]->(b) SET r.passage_id = "p11";

MATCH (a:Concept {id: "type2"}), (b:Concept {id: "prevention"}) MERGE (a)-[r:HAS_PREVENTION_TOPIC]->(b) SET r.passage_id = "p06";

MATCH (a:Concept {id: "diabetes"}), (b:Concept {id: "complication"}) MERGE (a)-[r:HAS_COMPLICATION_TOPIC]->(b) SET r.passage_id = "p10";

MATCH (a:Concept {id: "type2"}), (b:Concept {id: "activity"}) MERGE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.passage_id = "p05";

MATCH (a:Concept {id: "type2"}), (b:Concept {id: "family"}) MERGE (a)-[r:HAS_RISK_FACTOR]->(b) SET r.passage_id = "p05";

MATCH (a:Concept {id: "type1"}), (b:Concept {id: "symptom"}) MERGE (a)-[r:HAS_SYMPTOM_TOPIC]->(b) SET r.passage_id = "p09";

MATCH (a:Concept {id: "type2"}), (b:Concept {id: "symptom"}) MERGE (a)-[r:HAS_SYMPTOM_TOPIC]->(b) SET r.passage_id = "p09";

MATCH (a:Concept {id: "diabetes"}), (b:Concept {id: "a1c"}) MERGE (a)-[r:ASSESSED_BY]->(b) SET r.passage_id = "p08";

MATCH (a:Concept {id: "diabetes"}), (b:Concept {id: "glucose"}) MERGE (a)-[r:ASSESSED_BY]->(b) SET r.passage_id = "p08";

MATCH (a:Concept {id: "a1c"}), (b:Concept {id: "threshold"}) MERGE (a)-[r:HAS_INTERPRETATION_TOPIC]->(b) SET r.passage_id = "p24";

MATCH (a:Concept {id: "type1"}), (b:Concept {id: "glucose"}) MERGE (a)-[r:ASSESSED_BY]->(b) SET r.passage_id = "p03";

MATCH (a:Concept {id: "type1"}), (b:Concept {id: "antibody"}) MERGE (a)-[r:CLASSIFIED_WITH]->(b) SET r.passage_id = "p03";

MATCH (a:Concept {id: "diabetes"}), (b:Concept {id: "followup"}) MERGE (a)-[r:HAS_MONITORING_TOPIC]->(b) SET r.passage_id = "p17";
